# Leave false for the no-charge interactive demo. Set true only after the
# Firebase backend, owner account, and App Check registration are deployed.
VITE_STEMULATE_BACKEND_ENABLED=false
# Keep Spotify hidden and reject Spotify URLs until the private worker has both
# Spotify secrets mounted. Change to true only for that fully configured deploy.
VITE_ENABLE_SPOTIFY_IMPORT=false
VITE_FIREBASE_FUNCTIONS_REGION=us-central1
VITE_FIREBASE_APP_CHECK_SITE_KEY=
# Local-only: connect the browser to the ports in firebase.json.
VITE_USE_FIREBASE_EMULATORS=false

# Firebase web configuration. These identify the project and are not server secrets.
VITE_FIREBASE_API_KEY=AIzaSyDail4uDtgyAABB6RPHiQz2IrmE3gbw-_w
VITE_FIREBASE_AUTH_DOMAIN=stem-ulate.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=stem-ulate
VITE_FIREBASE_STORAGE_BUCKET=stem-ulate.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=582552566044
VITE_FIREBASE_APP_ID=1:582552566044:web:93272b75ab46889d9a22d9
VITE_FIREBASE_MEASUREMENT_ID=G-9PJCR4JTY6

# MUSIC_AI_API_KEY must never appear in this file. Set it with Firebase Secret Manager.
# Spotify client credentials must never appear here either. The private Cloud Run
# service reads them from Google Secret Manager; the browser does not need them.
