# Non-secret deployment parameters. Copy to .env.stem-ulate or answer the
# Firebase CLI prompts during deploy. Never put MUSIC_AI_API_KEY in this file.
OWNER_UIDS=replace-with-your-firebase-auth-uid
# The three non-secret Music.ai workflow slugs configured for this project.
# Stable keys are used for idempotent task names and output-collision handling.
MUSIC_AI_WORKFLOW_SLUGS=stems=stemulate-multistem,mapping=stemulate-harmony-beats,sections=stemulate-song-sections
# Backward-compatible alternative: set one slug here and leave
# MUSIC_AI_WORKFLOW_SLUGS empty.
MUSIC_AI_WORKFLOW_SLUG=
MUSIC_AI_INPUT_PARAM=inputUrl
MUSIC_AI_API_BASE_URL=https://api.music.ai/v1
MUSIC_AI_OUTPUT_HOSTS=cdn.music.ai,storage.googleapis.com
MAX_INPUT_BYTES=524288000
MAX_OUTPUT_BYTES=1073741824
MAX_ANALYSIS_OUTPUT_BYTES=16777216
MAX_OUTPUT_FILES=32
POLL_INITIAL_DELAY_SECONDS=15
POLL_MAX_DELAY_SECONDS=60
MUSIC_AI_MAX_POLLS=180
DOWNLOADER_SERVICE_URL=https://replace-with-private-cloud-run-service.run.app
DOWNLOADER_QUEUE_ID=stemulate-downloads
DOWNLOADER_INVOKER_SERVICE_ACCOUNT=replace-with-task-invoker@stem-ulate.iam.gserviceaccount.com
REMOTE_IMPORT_MAX_BYTES=104857600
REMOTE_IMPORT_DAILY_LIMIT=10
