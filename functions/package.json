{
  "name": "stemulate-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "npm run build && node --test test/*.test.cjs",
    "serve": "npm run build && firebase emulators:start --only auth,functions,firestore,storage",
    "deploy": "firebase deploy --only functions,firestore,storage",
    "set-owner": "node scripts/set-owner-claim.mjs"
  },
  "dependencies": {
    "@google-cloud/tasks": "^6.2.3",
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^6.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  }
}
