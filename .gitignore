# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem
**/__pycache__/
*.py[cod]

# stale local duplicates retained outside source control
/README 2.md
/tests/rendered-html.test 2.mjs

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/

# Native iOS generated files and machine-local signing/Firebase configuration
/ios/.tools/
/ios/Config/AppCheck.xcconfig
/ios/Config/Firebase.xcconfig
/ios/Config/Install.local
/ios/Config/Local.xcconfig
/ios/DerivedData/
/ios/STEMulate.xcodeproj/
/ios/STEMulate/Resources/GoogleService-Info.plist
