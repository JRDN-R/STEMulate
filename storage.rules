rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(userId) {
      return request.auth != null
        && request.auth.uid == userId
        && request.auth.token.owner == true;
    }

    function job(userId, jobId) {
      return firestore.get(
        /databases/(default)/documents/users/$(userId)/jobs/$(jobId)
      ).data;
    }

    match /users/{userId}/jobs/{jobId}/input/{fileName} {
      allow create: if isOwner(userId)
        && fileName.matches('source\\.[A-Za-z0-9]{1,8}')
        && request.resource.size > 0
        && request.resource.size <= 524288000
        && request.resource.size == job(userId, jobId).sizeBytes
        && request.resource.contentType.matches('(audio|video)/.*')
        && request.resource.contentType == job(userId, jobId).contentType
        && job(userId, jobId).sourceType == 'upload'
        && job(userId, jobId).status == 'awaiting_upload'
        && job(userId, jobId).inputPath
          == 'users/' + userId + '/jobs/' + jobId + '/input/' + fileName;

      allow read: if isOwner(userId);
      allow update: if false;
      allow delete: if isOwner(userId)
        && job(userId, jobId).status in ['completed', 'failed'];
    }

    match /users/{userId}/jobs/{jobId}/outputs/{fileName} {
      allow read: if isOwner(userId);
      allow create, update: if false;
      allow delete: if isOwner(userId)
        && job(userId, jobId).status in ['completed', 'failed'];
    }

    // Stream objects are written by the private preview worker and delivered
    // only through short-lived signed URLs returned by a trusted callable.
    match /users/{userId}/jobs/{jobId}/streams/v1/{streamPath=**} {
      allow read, write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
